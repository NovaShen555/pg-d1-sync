# Copy to .env and replace placeholders. Never commit .env.
POSTGRES_DSN=postgresql://app:replace_me@host.docker.internal:5432/mydb
POSTGRES_SCHEMA=public
CLOUDFLARE_API_TOKEN=replace_me
CLOUDFLARE_ACCOUNT_ID=replace_me
D1_DATABASE_ID=replace_me
SYNC_MODE=push
SYNC_INTERVAL_SECONDS=300
RETRY_DELAY_SECONDS=30
D1_BATCH_SIZE=20
D1_PAGE_SIZE=100
D1_REQUEST_TIMEOUT_SECONDS=30
SYNC_TABLES=
SYNC_ONCE=false
ALLOW_DESTRUCTIVE_PULL=false
LOG_LEVEL=INFO
